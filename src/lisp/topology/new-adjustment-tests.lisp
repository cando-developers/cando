;;;; Load after topology, then call (topology::test-new-adjustments).
(in-package :topology)

(defun test-new-adjustments ()
  (flet ((fails (thunk)
           (assert (handler-case (progn (funcall thunk) nil) (error () t))))
         (dot (a b) (reduce #'+ (map 'vector #'* a b)))
         (near (a b) (assert (< (abs (- a b)) 1.0d-12))))
    (assert (equal (remove-atom-adjustments
                    (copy-tree '(CM C :plugs (:-eside) :adjust old
                                 :new-adjustment new :adjustment future)))
                   '(CM C :plugs (:-eside))))
    (assert (eq (remove-atom-adjustments 'CM) 'CM))
    (let* ((spec '(:planar :references (CE (:plug :+amide))))
           (*named-adjustment-definitions* (make-hash-table :test #'eq)))
      (define-adjustment test-planar (:planar :references (CE (:plug :+amide))))
      (assert (equal spec (resolve-new-adjustment 'test-planar)))
      (assert (typep (instantiate-joint-adjustment spec nil) 'planar-adjustment))
      (let ((derived (%derivation-graph '((HNZ H :new-adjustment test-planar))
                      (lambda (plug) (if (eq plug :+amide) :+renamed plug)))))
        (assert (equal (getf (cdr (getf (cddar derived) :new-adjustment)) :references)
                       '(CE (:plug :+renamed)))))
      (dolist (bad '((:planar) (:planar :references (CE))
                     (:planar :references (CE CE))
                     (:planar :references (CE (:plug)))
                     (:planar :references (CE (:plug :+amide)) :orientation :positive)
                     (:planar :references (CE CM) :references (CE CN))))
        (fails (lambda () (validate-new-adjustment bad)))))
    (let* ((a #(1d0 0d0 0d0))
           (b (vector -1d0 (sqrt 3d0) 0d0)) ; length two, angle 120 degrees
           (direction (planar-adjustment-direction a b)))
      (near (dot direction direction) 1d0)
      (near (dot direction a) -0.5d0)
      (near (/ (dot direction b) 2d0) -0.5d0)
      (near (aref direction 2) 0d0)
      (map nil #'near direction (planar-adjustment-direction b a)))
    (dolist (bad '(#(0d0 0d0 0d0) #(1d0 0d0 0d0) #(-1d0 0d0 0d0)))
      (fails (lambda () (planar-adjustment-direction #(1d0 0d0 0d0) bad))))
    (let ((spec '(:tetrahedral-hydrogens :other-hydrogen HG2
                  :references (CG (:plug :+eside)) :orientation :positive)))
      (assert (equal spec (atom-adjustment-specification (list :new-adjustment spec))))
      (let ((*named-adjustment-definitions* (make-hash-table :test #'eq)))
        (define-adjustment test-hydrogens
          (:tetrahedral-hydrogens :other-hydrogen HG2
           :references (CG (:plug :+eside)) :orientation :positive))
        (let ((resolved (atom-adjustment-specification '(:new-adjustment test-hydrogens))))
          (assert (equal spec resolved))
          (setf (getf (cdr resolved) :orientation) :negative)
          (assert (equal spec (resolve-new-adjustment 'test-hydrogens))))
        (fails (lambda () (resolve-new-adjustment 'unknown-adjustment)))
        (let* ((graph '((HG1 H :new-adjustment test-hydrogens)))
               (derived (%derivation-graph graph (lambda (plug)
                                                  (if (eq plug :+eside) :+renamed plug)))))
          (assert (equal (getf (cdr (getf (cddar derived) :new-adjustment)) :references)
                         '(CG (:plug :+renamed))))
          (assert (equal spec (resolve-new-adjustment 'test-hydrogens))))
        (register-adjustment-definition 'test-hydrogens
          '(:tetrahedral-hydrogens :other-hydrogen HG2
            :references (CG (:plug :+eside)) :orientation :negative))
        (assert (eq (getf (cdr (resolve-new-adjustment 'test-hydrogens)) :orientation)
                    :negative)))
      (assert (eq 'internal-planar-adjustment
                  (atom-adjustment-specification '(:adjust internal-planar-adjustment))))
      ;; Presence of both keywords is an error, even if legacy value is NIL.
      (fails (lambda () (atom-adjustment-specification (list :adjust nil :new-adjustment spec))))
      (dolist (bad '(nil (:unknown)
                     (:tetrahedral-hydrogens :other-hydrogen HG2 :references (CG CM))
                     (:tetrahedral-hydrogens :other-hydrogen HG2 :references (CG CM)
                      :orientation :positive :orientation :negative)
                     (:tetrahedral-hydrogens :other-hydrogen HG2 :references (CG (:plug))
                      :orientation :positive)))
        (fails (lambda () (validate-new-adjustment bad))))
      (let* ((graph (list (list 'HG1 'H :new-adjustment spec)))
             (derived (%derivation-graph graph
                        (lambda (plug) (if (eq plug :+eside) :+renamed plug)))))
        (assert (equal (getf (cdr (getf (cddar derived) :new-adjustment)) :references)
                       '(CG (:plug :+renamed))))
        (assert (equal (getf (cdr spec) :references) '(CG (:plug :+eside))))))
    (dolist (angle (list (/ pi 2) (acos (/ -1.0d0 3)) (* pi 2/3)))
      (let ((a #(1.0d0 0.0d0 0.0d0))
            (b (vector (cos angle) (sin angle) 0.0d0)))
        (multiple-value-bind (h1 h2) (tetrahedral-hydrogen-directions a b :positive)
          (near (dot h1 h1) 1.0d0)
          (near (dot h2 h2) 1.0d0)
          (near (dot h1 h2) (/ -1.0d0 3))
          (near (dot a h1) (dot b h1))
          (assert (> (aref h1 2) 0.0d0))
          (assert (< (aref h2 2) 0.0d0))
          (multiple-value-bind (negative1 negative2)
              (tetrahedral-hydrogen-directions a b :negative)
            (map nil #'near h1 negative2)
            (map nil #'near h2 negative1))
          (multiple-value-bind (swapped1 swapped2)
              (tetrahedral-hydrogen-directions b a :positive)
            (map nil #'near h1 swapped2)
            (map nil #'near h2 swapped1)))))
    (fails (lambda () (tetrahedral-hydrogen-directions #(1d0 0d0 0d0) #(1d0 0d0 0d0) :positive)))
    (fails (lambda () (tetrahedral-hydrogen-directions #(1d0 0d0 0d0) #(-1d0 0d0 0d0) :positive))))
  (format t "~&NEW-ADJUSTMENT-TESTS-PASSED~%")
  t)

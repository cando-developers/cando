(defpackage #:topology-manipulator-tests
  (:use #:cl)
  (:export #:run-tests))

(in-package #:topology-manipulator-tests)

(defun signals-error-p (thunk)
  (handler-case (progn (funcall thunk) nil)
    (error () t)))

;;; SHAPE-KEY-LEGACY: positional driver cache tests; replaced by topology/shape-key-tests.
#+(or)
(defun test-binned-shape-keys ()
  (let* ((driver (make-instance 'topology:dihedral-driver
                                :name :bb1 :dihedral-joint nil
                                :internal-range (make-instance 'topology::range
                                                               :begin 2 :end 5)))
         (ring5 (make-instance 'topology:ring5-driver
                               :cremer-pople-range (make-instance 'topology::range :begin 0 :end 2)))
         (ring6 (make-instance 'topology:ring6-driver
                               :cremer-pople-range (make-instance 'topology::range :begin 5 :end 8)))
         (fused (make-instance 'topology:fused-ring-driver
                               :rings (make-instance 'topology::fused-ring :ring1 ring5 :ring2 ring6)))
         (cpinternals (vector 0.2d0 2.3d0 1.0d0 1.5d0 0.2d0 0.3d0 0.4d0 0.5d0))
         (five (list (topology::fscale-frac 0.2d0) (topology::fscale-deg 2.3d0)))
         (six (list (topology::fscale-frac 0.3d0) (topology::fscale-deg 0.4d0)
                    (topology::fscale-deg 0.5d0)))
         (angle (list (topology::fscale-deg 0.2d0))))
    (flet ((check (drivers names components)
             (let ((key (topology:binned-shape-key-cache drivers cpinternals)))
               (assert (typep key 'topology:binned-shape-key-cache))
               (assert (not (typep key 'topology:binned-shape-key)))
               (assert (equal (mapcar #'cons names components)
                              (topology:binned-shape-key-entries key)))
               (assert (equal names (topology:binned-shape-key-names key)))
               (assert (equal components (topology:binned-shape-key-components key))))))
      (check driver '(:bb1) (list angle))
      (check (list driver) '(:bb1) (list angle))
      (check ring5 '(:first-ring) (list five))
      (check ring6 '(:first-ring) (list six))
      (check fused '(:first-ring :second-ring) (list five six))
      (check (list driver ring5 ring6) '(:bb1 :first-ring :second-ring) (list angle five six))
      (check (list ring5 driver ring6) '(:first-ring :bb1 :second-ring) (list five angle six))
      (check (list driver fused) '(:bb1 :first-ring :second-ring) (list angle five six))
      (check nil nil nil))
    ;; Regression: (2 13) is one ring, never two scalar components.
    (let ((key (topology:binned-shape-key-cache (list ring5) cpinternals)))
      (assert (equal five (topology:binned-shape-key-component key :first-ring)))
      (assert (signals-error-p (lambda () (topology:binned-shape-key-component key :second-ring)))))
    (assert (string= (format nil "q~dp~d" (first five) (second five))
                     (topology::binned-shape-key-string ring5 cpinternals)))
    (assert (string= (format nil "Q~dt~dp~d" (first six) (second six) (third six))
                     (topology::binned-shape-key-string ring6 cpinternals)))
    (dolist (ring (list ring5 ring6))
      (let* ((key (topology:binned-shape-key-cache ring cpinternals))
             (bins (topology:binned-shape-key-component key :first-ring)))
        (topology:binned-shape-key-write ring cpinternals bins)
        (assert (equal bins (topology:binned-shape-key-component
                            (topology:binned-shape-key-cache ring cpinternals) :first-ring))))))
  (let ((cache (topology:make-binned-shape-key-cache '((:bb1 12) (:first-ring 2 13))))
        (key (topology:make-binned-shape-key '((:bb1 12) (:first-ring 2 13)))))
    (assert (eq (class-of cache) (find-class 'topology:binned-shape-key-cache)))
    (assert (eq (class-of key) (find-class 'topology:binned-shape-key)))
    (assert (not (typep cache 'topology:binned-shape-key)))
    (assert (equal (topology:binned-shape-key-names cache)
                   (topology:binned-shape-key-names key)))
    (assert (equal (topology:binned-shape-key-components cache)
                   (topology:binned-shape-key-components key)))
    (dolist (object (list cache key))
      (assert (equal '(12) (topology:binned-shape-key-component object :bb1)))
      (assert (equal '(2 13) (topology:binned-shape-key-component object :first-ring)))))
  (dolist (constructor (list #'topology:make-binned-shape-key-cache
                            #'topology:make-binned-shape-key))
    (dolist (entries '(12 (12) ((nil 1)) ((3 1)) ((:bb1 . 12))
                      ((:bb1)) ((:bb1 1.0)) ((:first-ring 1 2 3 4))
                      ((:bb1 1) . 2)))
      (assert (signals-error-p (lambda () (funcall constructor entries))))))
  (assert (signals-error-p
           (lambda () (topology:binned-shape-key-component
                       (topology:make-binned-shape-key-cache '((:bb1 1) (:bb1 2))) :bb1))))
  t)

;;; SHAPE-KEY-LEGACY: old bin ranges; replaced by tests/shape-key and cache-storage.
#+(or)
(defun test-binned-shape-key-serialization ()
  (dolist (constructor (list #'topology:make-binned-shape-key-cache
                            #'topology:make-binned-shape-key))
    (dolist (fields '(nil ((:bb1 12) (:first-ring 2 13) (:second-ring 3 9 -18))))
      (let ((original (funcall constructor fields)))
        (assert (typep original 'cando.serialize:serializable))
        (uiop:with-temporary-file (:pathname pathname)
          (cando.serialize:save-cando original pathname)
          (dolist (native-reader-p '(t nil))
            (let ((restored (cando.serialize:load-cando pathname
                              :use-native-reader native-reader-p)))
              (assert (eq (class-of original) (class-of restored)))
              (assert (equal fields (topology:binned-shape-key-entries restored)))
              (assert (equal (topology:binned-shape-key-names original)
                             (topology:binned-shape-key-names restored)))
              (assert (equal (topology:binned-shape-key-components original)
                             (topology:binned-shape-key-components restored)))
              (when (first fields)
                (assert (equal '(12) (topology:binned-shape-key-component restored :bb1)))
                (assert (equal '(2 13) (topology:binned-shape-key-component restored :first-ring)))))))))) )

(defun run-tests ()
  "Check static dihedral joint eligibility. Cache checks live in topology/shape-key-tests."
  (let* ((filename (asdf:system-relative-pathname
                    "topology" #p"../regression-tests/data/hexapeptide.mol2"))
         (aggregate (chem:load-mol2 filename))
         (molecule (chem:content-at aggregate 0))
         (residue (chem:content-at molecule 0))
         (atom-table (chem:make-atom-table))
         (atom-types (make-hash-table :test #'eq)))
    (chem:construct-from-molecule atom-table molecule nil nil atom-types)
    (flet ((name (index)
             (chem:get-name (chem:content-at residue index))))
      (let* ((root (kin:make-jump-joint '(0 0 0) (name 0) atom-table))
             (complex (kin:make-complex-bonded-joint '(0 0 1) (name 1) atom-table))
             (shallow (kin:make-bonded-joint '(0 0 2) (name 2) atom-table))
             (deep (kin:make-bonded-joint '(0 0 3) (name 3) atom-table))
             (nested-jump (kin:make-jump-joint '(0 0 4) (name 4) atom-table))
             (nested-complex (kin:make-complex-bonded-joint '(0 0 5) (name 5) atom-table)))
        (kin:joint/add-child root complex)
        (kin:joint/add-child complex shallow)
        (kin:joint/add-child shallow deep)
        (kin:joint/add-child deep nested-jump)
        (kin:joint/add-child nested-jump nested-complex)
        (assert (not (topology::static-dihedral-joint-p root)))
        (assert (not (topology::static-dihedral-joint-p complex)))
        (assert (not (topology::static-dihedral-joint-p shallow)))
        (assert (topology::static-dihedral-joint-p deep))
        (assert (not (topology::static-dihedral-joint-p nested-jump)))
        (assert (not (topology::static-dihedral-joint-p nested-complex))))))
  t)

(defpackage #:topology-shape-key-tests
  (:use #:cl)
  (:export #:run-tests))

(in-package #:topology-shape-key-tests)

(defun signals-error-p (thunk)
  (handler-case (progn (funcall thunk) nil) (error () t)))

(defun run-tests ()
  (dolist (constructor (list #'topology:make-binned-shape-key-cache
                            #'topology:make-binned-shape-key))
    (let* ((input (copy-tree '((:ring 2 13) (:bb1 12))))
           (key (funcall constructor input)))
      (assert (equal '((:bb1 12) (:ring 2 13))
                     (topology:binned-shape-key-entries key)))
      ;; Neither the input nor returned lists may mutate the stored key.
      (setf (second (first input)) 99)
      (let ((returned (topology:binned-shape-key-entries key)))
        (setf (second (first returned)) 99))
      (let ((returned (topology:binned-shape-key-component key :bb1)))
        (setf (first returned) 99))
      (assert (equal '(12) (topology:binned-shape-key-component key :bb1)))
      (dolist (bins '((12) (13)))
        (assert (signals-error-p
                 (lambda () (topology:add-binned-shape-key-entry key :bb1 bins)))))
      (assert (equal '((:bb1 12) (:ring 2 13))
                     (topology:binned-shape-key-entries key)))
      (topology:add-binned-shape-key-entry key :aa '(3))
      (assert (equal '(:aa :bb1 :ring) (topology:binned-shape-key-names key)))
      (assert (signals-error-p
               (lambda () (topology:binned-shape-key-component key :missing)))))
    (dolist (bad '(12 (12) ((:a . 12)) ((:a)) ((:a 1.0))
                  ((:a 1) (:a 1)) ((:a 1) (:a 2)) ((:a 1) . 2)))
      (assert (signals-error-p (lambda () (funcall constructor bad)))))
    (dolist (entries '(nil ((:ring 2 13) (:bb1 12))))
      (let ((original (funcall constructor entries)))
        (uiop:with-temporary-file (:pathname pathname)
          (cando.serialize:save-cando original pathname)
          (dolist (native '(t nil))
            (let ((restored (cando.serialize:load-cando pathname :use-native-reader native)))
              (assert (eq (class-of original) (class-of restored)))
              (assert (equal (topology:binned-shape-key-entries original)
                             (topology:binned-shape-key-entries restored)))))))))
  (let ((left (topology:make-binned-shape-key '((:ring 2 13) (:bb1 12))))
        (right (topology:make-binned-shape-key '((:bb1 12) (:ring 2 13))))
        (different (topology:make-binned-shape-key '((:bb1 13) (:ring 2 13)))))
    (assert (not (eq left right)))
    (assert (topology:binned-shape-key= left right))
    (assert (not (topology:binned-shape-key= left different))))
  ;; Same symbol spelling in different packages must not depend on input order.
  (let* ((a (intern "ORDER-TEST" :topology-shape-key-tests))
         (b (intern "ORDER-TEST" :keyword))
         (left (topology:make-binned-shape-key (list (list a 1) (list b 2))))
         (right (topology:make-binned-shape-key (list (list b 2) (list a 1)))))
    (assert (topology:binned-shape-key= left right)))
  (let* ((key (topology:make-binned-shape-key '((:ring 2 13) (:bb1 12))))
         (path (topology:binned-shape-key-pathname-part key)))
    (assert (string= path (topology:binned-shape-key-pathname-part
                          (topology:make-binned-shape-key '((:bb1 12) (:ring 2 13))))))
    (let ((*package* (find-package :cl)) (*print-case* :downcase)
          (*print-base* 16) (*print-radix* t) (*print-readably* t))
      (assert (string= path (topology:binned-shape-key-pathname-part key))))
    (let ((names (list :|A/B| :|A_2F_B| :|A~B| :|A--B|
                       (intern "A/B" :topology-shape-key-tests))))
      (let ((paths (mapcar (lambda (name)
                             (topology:binned-shape-key-pathname-part
                              (topology:make-binned-shape-key (list (list name 12))))) names)))
        (assert (= (length names) (length (remove-duplicates paths :test #'string=))))
        (assert (every (lambda (path) (not (find #\/ path))) paths)))))
  (format t "~&SHAPE-KEY-FOUNDATION-TESTS-PASSED~%")
  t)

(in-package #:topology-shape-key-tests)

(defun test-shape-key-map ()
  (let* ((map (topology:make-binned-shape-key-map))
         (original (topology:make-binned-shape-key '((:ring 2 13) (:bb1 12))))
         (equivalent (topology:make-binned-shape-key '((:bb1 12) (:ring 2 13))))
         (different (topology:make-binned-shape-key '((:bb1 13) (:ring 2 13)))))
    (setf (topology:binned-shape-key-map-value original map) :first)
    (assert (eq :first (topology:binned-shape-key-map-value equivalent map)))
    (setf (topology:binned-shape-key-map-value equivalent map) :updated)
    (assert (= 1 (topology:binned-shape-key-map-count map)))
    (multiple-value-bind (value presentp)
        (topology:binned-shape-key-map-value different map :missing)
      (assert (eq value :missing))
      (assert (not presentp)))
    (setf (topology:binned-shape-key-map-value different map) nil)
    (multiple-value-bind (value presentp) (topology:binned-shape-key-map-value different map)
      (assert (null value))
      (assert presentp))
    ;; Caller mutation cannot alter the stored key or invalidate its hash.
    (topology:add-binned-shape-key-entry original :other '(3))
    (assert (eq :updated (topology:binned-shape-key-map-value equivalent map)))
    (topology:map-binned-shape-keys
     (lambda (key value)
       (declare (ignore value))
       (topology:add-binned-shape-key-entry key :callback-only '(4))) map)
    (assert (eq :updated (topology:binned-shape-key-map-value equivalent map)))
    (uiop:with-temporary-file (:pathname pathname)
      (cando.serialize:save-cando map pathname)
      (dolist (native '(t nil))
        (let ((restored (cando.serialize:load-cando pathname :use-native-reader native)))
          (assert (typep restored 'topology:binned-shape-key-map))
          (assert (= 2 (topology:binned-shape-key-map-count restored)))
          (assert (eq :updated (topology:binned-shape-key-map-value equivalent restored)))
          (assert (nth-value 1 (topology:binned-shape-key-map-value different restored)))))))
  (format t "~&SHAPE-KEY-MAP-TESTS-PASSED~%")
  t)

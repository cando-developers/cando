(defun hexapeptide-atom-table-remove-counts ()
  "Return one row per atom in regression-tests/data/hexapeptide.mol2.

Each row has the form:

  (ATOM-TABLE-INDEX ATOM-NAME REMOVE-0-COUNT REMOVE-1-COUNT REMOVE-2-COUNT)

where remove 0/1/2 correspond to bonded, angle, and 1-4/dihedral
neighbors as stored in EnergyAtom::_AtomsAtRemoveBondAngle14.  This is
intended to generate the reference data before replacing the current
SpanningLoop-based atom-table construction."
  (let* ((filename (translate-logical-pathname
                    "sys:extensions;cando;src;lisp;regression-tests;data;hexapeptide.mol2"))
         (agg (chem:load-mol2 filename))
         (mol (chem:content-at agg 0))
         (atom-table (chem:make-atom-table))
         ;; keep-interaction-factory NIL means EnergyAtom construction does
         ;; not require a registered force field or atom type table.  The
         ;; bond graph still drives the remove-0/1/2 connectivity.
         (atom-types (make-hash-table :test #'eq)))
    (chem:construct-from-molecule atom-table mol nil nil atom-types)
    (loop for index below (chem:get-number-of-atoms atom-table)
          collect (list index
                        (chem:elt-atom-name atom-table index)
                        (length (chem:atoms-at-remove atom-table index 0))
                        (length (chem:atoms-at-remove atom-table index 1))
                        (length (chem:atoms-at-remove atom-table index 2))))))

(defun print-hexapeptide-atom-table-remove-counts
    (&optional (stream *standard-output*))
  "Print the hexapeptide remove-count table as a readable Lisp literal."
  (let ((rows (hexapeptide-atom-table-remove-counts)))
    (format stream "~&Hexapeptide atom-table remove counts (~d atoms):~%" (length rows))
    (format stream "'(~%")
    (dolist (row rows)
      (format stream "  ~s~%" row))
    (format stream ")~%")
    (finish-output stream)
    rows))

